# ---------- Server ----------
PORT=3000
# Public base URL for this service once it's reachable from the internet
# (needed so Twilio + DronaHQ can call back into it). Use ngrok/localtunnel
# for local testing, e.g. https://abcd1234.ngrok-free.app
PUBLIC_BASE_URL=https://REPLACE_ME.ngrok-free.app

# ---------- Twilio ----------
# From twilio.com/console. Paste these into your OWN terminal / .env,
# never into chat.
TWILIO_ACCOUNT_SID=REPLACE_ME
TWILIO_AUTH_TOKEN=REPLACE_ME
TWILIO_SMS_FROM_NUMBER=+1REPLACEME

# ---------- DronaHQ Agentic Platform ----------
# Developer -> API Keys in agents.dronahq.com. Scope: Voice Agent (+ Agent
# if you also use the conversation-agent webhook flow below).
DRONAHQ_API_KEY=sk_REPLACE_ME
# Your account's Agentic Platform API host, shown next to your API key.
DRONAHQ_API_HOST=https://REPLACE_ME.dronahq.com

# The published Voice SDR Agent's UUID (Voice Agent -> your agent -> Publish)
DRONAHQ_VOICE_AGENT_ID=REPLACE_ME

# The unique Webhook Trigger URL + its api-key for your Conversation Agent
# (Agent -> Triggers -> Webhook). This agent's job: given lead context + the
# incoming SMS text, decide the next message and action.
DRONAHQ_CONVERSATION_WEBHOOK_URL=https://REPLACE_ME.dronahq.com/webhook/REPLACE_ME
DRONAHQ_CONVERSATION_WEBHOOK_API_KEY=REPLACE_ME

# ---------- SMS provider ----------
# "twilio" | "textbelt" | leave unset for mock mode.
# textbelt = free, no signup, via textbelt.com. The literal key "textbelt"
# is Textbelt's own public demo key: free forever but capped at 1 SMS/day
# SHARED GLOBALLY across everyone using it. Get a private key at
# textbelt.com for a guaranteed per-account quota.
SMS_PROVIDER=REPLACE_ME
TEXTBELT_API_KEY=textbelt

# ---------- Email provider (free, optional) ----------
# "gmail" | "resend" | leave unset for mock mode.
# gmail  = your own Gmail account's SMTP + an App Password (needs 2-Step
#          Verification turned on at myaccount.google.com/security).
#          Generate one at myaccount.google.com/apppasswords.
# resend = resend.com free tier (100/day). Sign up, grab an API key. No
#          domain verification needed if you send from onboarding@resend.dev.
EMAIL_PROVIDER=REPLACE_ME
GMAIL_USER=REPLACE_ME
GMAIL_APP_PASSWORD=REPLACE_ME
RESEND_API_KEY=REPLACE_ME
RESEND_FROM=onboarding@resend.dev
